{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tunnel-singularity",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "SPACES", "class_name": "SingularitySpace" }]
