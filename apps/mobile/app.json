{
  "expo": {
    "name": "Tunnel",
    "slug": "tunnel",
    "version": "0.1.0",
    "scheme": "tunnel",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../desktop/src-tauri/icons/icon.png",
    "android": {
      "package": "app.tunnel.mobile",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../desktop/src-tauri/icons/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundColor": "#f2f4ed"
      }
    },
    "ios": {
      "bundleIdentifier": "app.tunnel.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Tunnel sends text and files directly to your linked desktop on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "./plugins/with-tunnel.cjs",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tunnel to scan your desktop\u00e2\u20ac\u2122s pairing QR.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 28
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 8,
            "NSExtensionActivationSupportsFileWithMaxCount": 8
          },
          "androidMultiIntentFilters": []
        }
      ],
      "expo-sharing"
    ]
  }
}
